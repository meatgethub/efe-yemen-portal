# نسخة تجريبية — ضع القيم الحقيقية عند التشغيل الفعلي
# الوضع التجريبي: عند true يعرض رمز التحقق على الشاشة ويسجّل الإشعارات في سجل داخلي بدل الإرسال الحقيقي
DEMO_MODE=true
# مفتاح توقيع الجلسات (غيّره في الإنتاج لسلسلة عشوائية طويلة)
SESSION_SECRET=change-me-in-production-efe-yemen-2026
# المنطقة الزمنية للمواعيد النهائية
TZ=Asia/Aden

# --- التكاملات الحقيقية (اختياري، للإنتاج فقط) ---
# SMTP للبريد: عند ضبطها تُرسل الإشعارات فعلياً بدل الوضع التجريبي
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.org
# Twilio / SMS للرسائل النصية:
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
